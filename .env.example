# Required: Nebius Token Factory API key (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# Optional: Tavily key for documentation search (https://tavily.com)
TAVILY_API_KEY=

# Optional but recommended: a GitHub token (read-only, public repos) to avoid GitHub's 60 requests/hour limit
GITHUB_TOKEN=

# Optional: override the NVIDIA models (defaults shown)
# NEBIUS_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_SMART_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
